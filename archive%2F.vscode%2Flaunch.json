{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行：显示面板",
      "type": "debugpy",
      "request": "launch",
      "module": "gpuswitch",
      "args": ["--show"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "运行：后台启动（热键呼出）",
      "type": "debugpy",
      "request": "launch",
      "module": "gpuswitch",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "自检（环境 + 显卡 + 计数器 + 热键 + 界面）",
      "type": "debugpy",
      "request": "launch",
      "module": "gpuswitch",
      "args": ["--check"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "全功能测试套件（31 项）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/test-all.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "锁定守护逻辑自检",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/lock-selftest.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "显卡硬件状态（--hw-status）",
      "type": "debugpy",
      "request": "launch",
      "module": "gpuswitch",
      "args": ["--hw-status"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "打印显卡信息 (JSON)",
      "type": "debugpy",
      "request": "launch",
      "module": "gpuswitch",
      "args": ["--json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "渲染界面截图（开发用）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/screenshot.py",
      "args": ["assets/panel-preview.png"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
